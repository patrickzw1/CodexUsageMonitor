<Application x:Class="CodexUsageMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:converters="clr-namespace:CodexUsageMonitor.Converters">
    <Application.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />

        <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="FluentIconFont">pack://application:,,,/CodexUsageMonitor;component/Assets/#FluentSystemIcons-Regular</FontFamily>

        <Color x:Key="InkColor">#151823</Color>
        <Color x:Key="MutedColor">#515A6C</Color>
        <Color x:Key="IndigoColor">#315FC7</Color>
        <Color x:Key="BlueColor">#3978E7</Color>
        <Color x:Key="VioletColor">#7C63E7</Color>
        <Color x:Key="AmberColor">#C98016</Color>
        <Color x:Key="GreenColor">#168465</Color>
        <Color x:Key="LineColor">#4DD0D7E2</Color>
        <Color x:Key="SurfaceColor">#E8F5F7FB</Color>
        <Color x:Key="CardColor">#BFFDFEFF</Color>
        <Color x:Key="SubtleColor">#160F172A</Color>

        <!-- 可变语义色板：ThemeManager 只更新这些共享画刷，所有页面同步切换主题。 -->
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="FrameBorderBrush" Color="#78FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#9FFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#DEFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#B8FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#8FFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="TabHostBrush" Color="#34FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="TabSelectedBrush" Color="#E6FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="RangeHostBrush" Color="#42FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="InsetBrush" Color="#24FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="InnerCardBrush" Color="#34FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="InnerCardBorderBrush" Color="#63FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="HoverBrush" Color="#140F172A" po:Freeze="False" />
        <SolidColorBrush x:Key="PressedBrush" Color="#220F172A" po:Freeze="False" />
        <SolidColorBrush x:Key="PillBrush" Color="#D9DEE7" po:Freeze="False" />
        <SolidColorBrush x:Key="PillHoverBrush" Color="#C9D0DB" po:Freeze="False" />
        <SolidColorBrush x:Key="PillPressedBrush" Color="#B8C2D0" po:Freeze="False" />
        <SolidColorBrush x:Key="PillBorderBrush" Color="#6B9AA4B4" po:Freeze="False" />
        <SolidColorBrush x:Key="ToggleTrackBrush" Color="#C8CDD6" po:Freeze="False" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#260F172A" po:Freeze="False" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#806B7280" po:Freeze="False" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A65D6678" po:Freeze="False" />
        <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="#C8315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="WarningPanelBrush" Color="#D9FFF4DC" po:Freeze="False" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#85E4AA57" po:Freeze="False" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#87520A" po:Freeze="False" />
        <SolidColorBrush x:Key="IndigoSubtleBrush" Color="#26315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="IndigoTrackBrush" Color="#2A315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="AmberSubtleBrush" Color="#27E6A63B" po:Freeze="False" />
        <SolidColorBrush x:Key="AmberTrackBrush" Color="#35E6A63B" po:Freeze="False" />
        <SolidColorBrush x:Key="VioletSubtleBrush" Color="#228667E8" po:Freeze="False" />
        <SolidColorBrush x:Key="PaceConsumedBrush" Color="#97A0AF" po:Freeze="False" />
        <SolidColorBrush x:Key="PaceDividerBrush" Color="#F8FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="PaceMarkerBrush" Color="#1F2937" po:Freeze="False" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1,3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="MinWidth" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="9" Background="Transparent" Margin="0,3,2,3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#33445B76" BlurRadius="18" ShadowDepth="3" Opacity="0.16" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource FluentIconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateEntryButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource IndigoBrush}" />
            <Setter Property="Background" Value="{DynamicResource IndigoSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="15">
                            <Grid>
                                <Popup x:Name="HoverLabel"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Top"
                                       VerticalOffset="-8"
                                       AllowsTransparency="True"
                                       StaysOpen="True"
                                       IsHitTestVisible="False"
                                       Focusable="False">
                                    <Border Background="{DynamicResource BlueBrush}"
                                            CornerRadius="15"
                                            Padding="13,6">
                                        <TextBlock Text="{DynamicResource LocUpdateAvailable}"
                                                   Foreground="White"
                                                   FontFamily="{StaticResource UiFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" />
                                    </Border>
                                </Popup>
                                <Viewbox Width="17" Height="17" HorizontalAlignment="Right" Margin="0,0,7,0">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 10,2 L 10,12 M 6,8 L 10,12 L 14,8 M 4,16 L 16,16"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BlueBrush}" />
                                <Setter TargetName="HoverLabel" Property="IsOpen" Value="True" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BlueBrush}" />
                                <Setter TargetName="HoverLabel" Property="IsOpen" Value="True" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdatePrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource BlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource PillBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PillBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.Placement" Value="Top" />
            <Setter Property="ToolTipService.VerticalOffset" Value="-8" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PillHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PillPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource IndigoBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextActionButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}">
            <Setter Property="Foreground" Value="{DynamicResource IndigoBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource CardHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedTab" TargetType="ToggleButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="14" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource TabSelectedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeToggle" TargetType="ToggleButton" BasedOn="{StaticResource SegmentedTab}">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="SettingsChoice" TargetType="ToggleButton" BasedOn="{StaticResource SegmentedTab}">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="{DynamicResource ToggleTrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="12">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" Margin="3" HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource IndigoBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource BlueBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" ClipToBounds="True">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="4" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        </Style>
    </Application.Resources>
</Application>
