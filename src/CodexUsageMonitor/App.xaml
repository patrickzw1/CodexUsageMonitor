<Application x:Class="CodexUsageMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:ui="clr-namespace:CodexUsageMonitor"
             xmlns:converters="clr-namespace:CodexUsageMonitor.Converters">
    <Application.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />

        <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="FluentIconFont">pack://application:,,,/CodexUsageMonitor;component/Assets/#FluentSystemIcons-Regular</FontFamily>

        <!-- 共享尺寸与层级：页面可按语义复用，不把视觉常量散落到新控件。 -->
        <sys:Double x:Key="Space1">4</sys:Double>
        <sys:Double x:Key="Space2">8</sys:Double>
        <sys:Double x:Key="Space3">12</sys:Double>
        <sys:Double x:Key="Space4">16</sys:Double>
        <sys:Double x:Key="Space5">24</sys:Double>
        <sys:Double x:Key="ControlDisabledOpacity">0.45</sys:Double>
        <sys:Double x:Key="ControlLoadingOpacity">0.72</sys:Double>
        <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="CardCornerRadius">17</CornerRadius>
        <CornerRadius x:Key="FlyoutCornerRadius">16</CornerRadius>
        <Thickness x:Key="ControlBorderThickness">1</Thickness>
        <DropShadowEffect x:Key="FlyoutShadow" Color="#55000000" BlurRadius="24" ShadowDepth="5" Opacity="0.28" />

        <Color x:Key="InkColor">#151823</Color>
        <Color x:Key="MutedColor">#515A6C</Color>
        <Color x:Key="IndigoColor">#315FC7</Color>
        <Color x:Key="BlueColor">#3978E7</Color>
        <Color x:Key="VioletColor">#7C63E7</Color>
        <Color x:Key="AmberColor">#C98016</Color>
        <Color x:Key="GreenColor">#168465</Color>
        <Color x:Key="LineColor">#4DD0D7E2</Color>
        <Color x:Key="SurfaceColor">#E8F5F7FB</Color>
        <Color x:Key="CardColor">#BFFDFEFF</Color>
        <Color x:Key="SubtleColor">#160F172A</Color>

        <!-- 可变语义色板：ThemeManager 只更新这些共享画刷，所有页面同步切换主题。 -->
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="VioletBrush" Color="{StaticResource VioletColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="#FFF9FBFE" po:Freeze="False" />
        <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FFCBD3E1" po:Freeze="False" />
        <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}" po:Freeze="False" />
        <SolidColorBrush x:Key="FrameBorderBrush" Color="#78FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#9FFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#DEFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#B8FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#8FFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="TabHostBrush" Color="#34FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#FFDCE7FF" po:Freeze="False" />
        <SolidColorBrush x:Key="SelectionHoverBrush" Color="#FFD1DFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="RangeHostBrush" Color="#42FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="InsetBrush" Color="#24FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="InnerCardBrush" Color="#34FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="InnerCardBorderBrush" Color="#63FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="HoverBrush" Color="#140F172A" po:Freeze="False" />
        <SolidColorBrush x:Key="PressedBrush" Color="#220F172A" po:Freeze="False" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#7C8492" po:Freeze="False" />
        <SolidColorBrush x:Key="AccentBrush" Color="#315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#2853B0" po:Freeze="False" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#214795" po:Freeze="False" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#26315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="AccentFaintBrush" Color="#14315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="AccentFocusBrush" Color="#3978E7" po:Freeze="False" />
        <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#D9DEE7" po:Freeze="False" />
        <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#C9D0DB" po:Freeze="False" />
        <SolidColorBrush x:Key="ButtonSecondaryPressedBrush" Color="#B8C2D0" po:Freeze="False" />
        <SolidColorBrush x:Key="ButtonSecondaryBorderBrush" Color="#FF6B778A" po:Freeze="False" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" po:Freeze="False" />
        <SolidColorBrush x:Key="OnErrorBrush" Color="#FFFFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="ButtonDangerHoverBrush" Color="#961E16" po:Freeze="False" />
        <SolidColorBrush x:Key="ButtonDangerPressedBrush" Color="#7A1812" po:Freeze="False" />
        <SolidColorBrush x:Key="ToggleTrackBrush" Color="#C8CDD6" po:Freeze="False" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#260F172A" po:Freeze="False" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#806B7280" po:Freeze="False" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A65D6678" po:Freeze="False" />
        <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="#C8315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="WarningPanelBrush" Color="#D9FFF4DC" po:Freeze="False" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#85E4AA57" po:Freeze="False" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="#87520A" po:Freeze="False" />
        <SolidColorBrush x:Key="IndigoSubtleBrush" Color="#26315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="IndigoTrackBrush" Color="#2A315FC7" po:Freeze="False" />
        <SolidColorBrush x:Key="AmberSubtleBrush" Color="#27E6A63B" po:Freeze="False" />
        <SolidColorBrush x:Key="AmberTrackBrush" Color="#35E6A63B" po:Freeze="False" />
        <SolidColorBrush x:Key="VioletSubtleBrush" Color="#228667E8" po:Freeze="False" />
        <SolidColorBrush x:Key="PaceConsumedBrush" Color="#97A0AF" po:Freeze="False" />
        <SolidColorBrush x:Key="PaceDividerBrush" Color="#F8FFFFFF" po:Freeze="False" />
        <SolidColorBrush x:Key="PaceMarkerBrush" Color="#1F2937" po:Freeze="False" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBody" Background="{TemplateBinding Background}" CornerRadius="4" Margin="1,3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbActiveBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="MinWidth" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="9" Background="Transparent" Margin="0,3,2,3">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="GlassCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#33445B76" BlurRadius="18" ShadowDepth="3" Opacity="0.16" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyboardFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource AccentFocusBrush}"
                                BorderThickness="2"
                                CornerRadius="12"
                                Margin="-3">
                            <AdornedElementPlaceholder />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ButtonTextContentTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       TextAlignment="Center"
                       TextWrapping="NoWrap" />
        </DataTemplate>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        </Style>

        <Style x:Key="ButtonIcon" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontFamily" Value="{StaticResource FluentIconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlDisabledOpacity}" />
                            </Trigger>
                            <Trigger Property="ui:UiState.IsLoading" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlLoadingOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonIcon}" />

        <Style x:Key="UpdateEntryButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentFaintBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Width="30"
                                Height="30"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                ClipToBounds="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ExpansionStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Compact" To="Expanded" GeneratedDuration="0:0:0.18">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition From="Expanded" To="Compact" GeneratedDuration="0:0:0.14">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Compact">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Width" To="30" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="UpdateIcon" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="ExpandedLabel" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Expanded">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Width" To="88" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="UpdateIcon" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="ExpandedLabel" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Viewbox x:Name="UpdateIcon" Width="17" Height="17" Opacity="1" HorizontalAlignment="Right" Margin="0,0,7,0">
                                    <Canvas Width="20" Height="20">
                                        <Path Data="M 10,2 L 10,12 M 6,8 L 10,12 L 14,8 M 4,16 L 16,16"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="ExpandedLabel"
                                           Text="{DynamicResource LocUpdateNow}"
                                           Opacity="0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontFamily="{StaticResource UiFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ui:UiState.IsExpanded" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="ui:UiState.IsOpen" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlDisabledOpacity}" />
                            </Trigger>
                            <Trigger Property="ui:UiState.IsLoading" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlLoadingOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="ContentTemplate" Value="{StaticResource ButtonTextContentTemplate}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlDisabledOpacity}" />
                            </Trigger>
                            <Trigger Property="ui:UiState.IsLoading" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlLoadingOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdatePrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate" Value="{StaticResource ButtonTextContentTemplate}" />
        </Style>

        <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnErrorBrush}" />
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonDangerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonDangerPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlDisabledOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonLoading" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="{StaticResource ControlLoadingOpacity}" />
        </Style>

        <Style x:Key="ButtonTertiary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlDisabledOpacity}" />
                            </Trigger>
                            <Trigger Property="ui:UiState.IsLoading" Value="True">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter TargetName="Root" Property="Opacity" Value="{StaticResource ControlLoadingOpacity}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource ButtonTertiary}" />

        <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="ToolTipService.Placement" Value="Top" />
            <Setter Property="ToolTipService.VerticalOffset" Value="-8" />
            <Setter Property="ToolTipService.HorizontalOffset" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
