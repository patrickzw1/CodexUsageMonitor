<Window x:Class="CodexUsageMonitor.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource LocTrayMenuTitle}"
        Width="246"
        Height="254"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="TrayMenuButton" TargetType="Button" BasedOn="{StaticResource PillActionButton}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource FlyoutSurfaceBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="8,5,8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" Background="{DynamicResource IndigoSubtleBrush}" CornerRadius="10">
                    <TextBlock Text="&#xF481;" FontFamily="{StaticResource FluentIconFont}" FontSize="16"
                               Foreground="{DynamicResource IndigoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource LocAppTitle}" FontSize="14" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{Binding SyncStatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource LocAutoRefresh}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource LineBrush}" />

            <StackPanel Grid.Row="2" Margin="0,7,0,0">
                <Button Style="{StaticResource TrayMenuButton}" Click="OpenButton_Click" ToolTip="{DynamicResource LocOpenPanelTooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF583;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource LocOpenPanel}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource TrayMenuButton}" Click="RefreshButton_Click" ToolTip="{DynamicResource LocRefreshNowTooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xF194;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource LocRefreshNow}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource TrayMenuButton}" Click="DataButton_Click" ToolTip="{DynamicResource LocOpenDataFolder}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Data="M 1.5,3 L 5,3 L 6.2,4.4 L 10.5,4.4 L 10.5,9.5 L 1.5,9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{DynamicResource LocOpenDataFolder}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="8,4" />
                <Button Style="{StaticResource TrayMenuButton}" Click="QuitButton_Click" ToolTip="{DynamicResource LocQuitApplication}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Line X1="2" Y1="2" X2="10" Y2="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Line X1="10" Y1="2" X2="2" Y2="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{DynamicResource LocQuit}" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
