<UserControl x:Class="CodexUsageMonitor.Views.ResetCardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Margin="16,14,18,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource PillActionButton}" Command="{Binding ShowOverviewCommand}" ToolTip="返回总览" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF15C;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" Margin="0,0,5,0" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="重置卡详情" FontSize="21" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ResetDetailsStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="{Binding SyncStatusBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding SyncText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="刷新数据">
                    <TextBlock Text="&#xF194;" FontFamily="{StaticResource FluentIconFont}" FontSize="18" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToolTip}">
                    <TextBlock Text="{Binding ThemeIcon}" FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,4,22,22">
                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="165" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ResetCreditCountValueText}" FontSize="48" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}" />
                                <TextBlock Text="次可用" FontSize="17" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Bottom" Margin="7,0,0,8" />
                            </StackPanel>
                            <TextBlock Text="{Binding ResetSummary}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,4" />
                        <StackPanel Grid.Column="2" Margin="24,9,0,0">
                            <TextBlock Text="有效期进度" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ResetNearestExpiry}" Foreground="{DynamicResource AmberBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <ProgressBar Style="{StaticResource FlatProgressBar}" Height="8" Margin="0,16,0,7" Maximum="100" Value="{Binding ResetTimelinePercent, Mode=OneWay}" Foreground="{DynamicResource AmberBrush}" Background="{DynamicResource AmberTrackBrush}" />
                            <Grid><TextBlock Text="授予" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock Text="当前" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" /><TextBlock Text="到期" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" FontSize="11" /></Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="可用重置卡" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding ResetCredits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InnerCardBrush}" BorderBrush="{DynamicResource InnerCardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" Background="{DynamicResource AmberSubtleBrush}" CornerRadius="10">
                                                <TextBlock Text="&#xED7D;" FontFamily="{StaticResource FluentIconFont}" Foreground="{DynamicResource AmberBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Count}" FontWeight="SemiBold" /><TextBlock Text=" · " Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Expires}" FontWeight="SemiBold" /></StackPanel>
                                                <TextBlock Text="{Binding Granted}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Remaining}" Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" MaxWidth="118" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="13"
                                Visibility="{Binding HasResetCreditRows, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding ResetCreditEmptyText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="历史记录" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="从首次运行开始记录；服务端缺少单卡详情时，使用与过期会标记为推测。" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,8" />
                        <ItemsControl ItemsSource="{Binding ResetHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xED7D;" FontFamily="{StaticResource FluentIconFont}" Foreground="{DynamicResource IndigoBrush}" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Date}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="{DynamicResource VioletSubtleBrush}" CornerRadius="7" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding IsInferred, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource VioletBrush}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GlassCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" Background="{DynamicResource IndigoSubtleBrush}" CornerRadius="10">
                            <TextBlock Text="&#xED7D;" FontFamily="{StaticResource FluentIconFont}" Foreground="{DynamicResource IndigoBrush}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                            <TextBlock Text="到期前提醒" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ResetNotificationStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}" IsEnabled="{Binding HasResetExpiry}" VerticalAlignment="Center" ToolTip="{Binding ResetNotificationStatus}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource ChromeBrush}">
            <Grid Margin="18,8,16,8">
                <Button Style="{StaticResource TextActionButton}" Command="{Binding OpenUsagePageCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF583;" FontFamily="{StaticResource FluentIconFont}" FontSize="16" Margin="0,0,7,0" /><TextBlock Text="打开 Codex 用量页面" /></StackPanel>
                </Button>
                <Button Style="{StaticResource PillActionButton}" Command="{Binding OpenDataFolderCommand}" ToolTip="打开数据目录" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Path Data="M 1.5,3 L 5,3 L 6.2,4.4 L 10.5,4.4 L 10.5,9.5 L 1.5,9.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round" />
                        </Grid>
                        <TextBlock Text="数据" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
