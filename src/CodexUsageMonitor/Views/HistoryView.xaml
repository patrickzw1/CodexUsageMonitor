<UserControl x:Class="CodexUsageMonitor.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CodexUsageMonitor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,4,22,22">
            <StackPanel Margin="2,0,2,12">
                <TextBlock Text="{DynamicResource LocHistoryTrends}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource LocHistoryDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LocHistoryRange}" Style="{StaticResource SectionHeader}" />
                    <Grid Background="{DynamicResource RangeHostBrush}" Margin="0,-3,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="HistoryMonthModeButton" Content="{DynamicResource LocHistoryMonthMode}" Style="{StaticResource HistoryRangeToggle}" IsChecked="{Binding IsHistoryMonthMode, Mode=OneWay}" Command="{Binding SelectHistoryMonthModeCommand}" />
                        <ToggleButton x:Name="HistoryCustomModeButton" Grid.Column="1" Content="{DynamicResource LocHistoryCustomMode}" Style="{StaticResource HistoryRangeToggle}" IsChecked="{Binding IsHistoryCustomMode, Mode=OneWay}" Command="{Binding SelectHistoryCustomModeCommand}" />
                    </Grid>

                    <Grid Visibility="{Binding IsHistoryMonthMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource LocHistoryYear}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,5,4" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource LocHistoryMonth}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="5,0,0,4" />
                        <Button x:Name="HistoryPreviousMonthButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding PreviousHistoryMonthCommand}" ToolTip="{DynamicResource LocHistoryPreviousMonth}">
                            <Path Width="6" Height="10" Data="M 6,0 L 0,5 L 6,10" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                        </Button>
                        <ComboBox x:Name="HistoryYearPicker" Grid.Row="1" Grid.Column="1" Style="{StaticResource HistoryComboBox}" ItemsSource="{Binding HistoryYears}" SelectedItem="{Binding SelectedHistoryYear, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0" />
                        <ComboBox x:Name="HistoryMonthPicker" Grid.Row="1" Grid.Column="2" Style="{StaticResource HistoryComboBox}" ItemsSource="{Binding HistoryMonths}" SelectedItem="{Binding SelectedHistoryMonth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0,0,0" />
                        <Button x:Name="HistoryNextMonthButton" Grid.Row="1" Grid.Column="3" Style="{StaticResource IconButton}" Command="{Binding NextHistoryMonthCommand}" IsEnabled="{Binding CanSelectNextHistoryMonth}" ToolTip="{DynamicResource LocHistoryNextMonth}">
                            <Path Width="6" Height="10" Data="M 0,0 L 6,5 L 0,10" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                        </Button>
                        <Button Grid.Row="2" Grid.ColumnSpan="4" Style="{StaticResource ButtonPrimary}" Command="{Binding ApplyHistoryRangeCommand}" Content="{DynamicResource LocHistoryApplyRange}" Margin="0,10,0,0" />
                    </Grid>

                    <Grid x:Name="HistoryCustomRangePanel" Visibility="{Binding IsHistoryCustomMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="{DynamicResource LocHistoryStartDate}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DatePicker x:Name="HistoryStartDatePicker" Style="{StaticResource HistoryDatePicker}" SelectedDate="{Binding HistoryCustomStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateEnd="{Binding HistoryMaximumDate, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="{DynamicResource LocHistoryEndDate}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4" />
                            <DatePicker x:Name="HistoryEndDatePicker" Style="{StaticResource HistoryDatePicker}" SelectedDate="{Binding HistoryCustomEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayDateEnd="{Binding HistoryMaximumDate, Mode=OneWay}" />
                        </StackPanel>
                        <Button x:Name="HistoryCustomApplyButton" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource ButtonPrimary}" Command="{Binding ApplyHistoryRangeCommand}" Content="{DynamicResource LocHistoryApplyRange}" Margin="0,10,0,0" />
                    </Grid>

                    <Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,10,0,0" Visibility="{Binding HasHistoryValidationError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding HistoryValidationMessage}" Foreground="{DynamicResource ErrorBrush}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LocHistoryOfficialSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding HistoryRangeSummary}" FontWeight="SemiBold" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding HistoryOfficialTokens}" FontSize="31" FontWeight="SemiBold" Margin="0,7,0,0" />
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource LocHistoryReturnedDays}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HistoryOfficialReturnedDays}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="{DynamicResource LocHistoryDailyAverage}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HistoryOfficialAverageTokens}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource LocHistoryPeakDay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding HistoryOfficialPeakDate}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource LocHistoryPeakTokens}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding HistoryOfficialPeakTokens}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding HistoryOfficialStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LocHistoryLocalSample}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{DynamicResource LocHistoryLocalDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,10" />
                    <UniformGrid x:Name="HistoryLocalSummaryGrid" Columns="2">
                        <StackPanel MinHeight="66" Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource LocHistoryLocalTokens}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HistoryLocalTokens}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel MinHeight="66" Margin="8,0,0,8">
                            <TextBlock Text="{DynamicResource LocCurrentEstimatedCost}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HistoryLocalCost}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource IndigoBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel MinHeight="66" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource LocHistoryLocalCacheHit}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HistoryLocalCacheHit}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel MinHeight="66" Margin="8,0,0,0">
                            <TextBlock Text="{DynamicResource LocCostWithoutCaching}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HistoryLocalCostWithoutCaching}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource IndigoBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock x:Name="HistoryLocalSavingsRelationship" Foreground="{DynamicResource GreenBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="{DynamicResource LocCacheSavings}" /><Run Text="{Binding HistoryLocalCacheSavings, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{DynamicResource LocCostWithoutCachingHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsHistoryRangeLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding HistoryLocalPricingStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="HistoryDailyCard" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid x:Name="HistoryDailyHeader" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HistoryDailyTitle" Text="{DynamicResource LocHistoryDailyRange}" Style="{StaticResource SectionHeader}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <RadioButton x:Name="HistoryListButton" GroupName="HistoryDailyView" Style="{StaticResource HistoryViewToggle}"
                                         IsChecked="{Binding IsHistoryListVisible, Mode=TwoWay}" Command="{Binding ShowHistoryListCommand}"
                                         ToolTip="{DynamicResource LocHistoryList}" AutomationProperties.Name="{DynamicResource LocHistoryList}">
                                <Path Width="18" Height="16" Data="M 0,2 L 2,2 M 6,2 L 18,2 M 0,8 L 2,8 M 6,8 L 18,8 M 0,14 L 2,14 M 6,14 L 18,14"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" />
                            </RadioButton>
                            <RadioButton x:Name="HistoryTrendButton" GroupName="HistoryDailyView" Style="{StaticResource HistoryViewToggle}" Margin="4,0,0,0"
                                         IsChecked="{Binding IsHistoryTrendVisible, Mode=TwoWay}" Command="{Binding ShowHistoryTrendCommand}"
                                         ToolTip="{DynamicResource LocHistoryTrend}" AutomationProperties.Name="{DynamicResource LocHistoryTrend}">
                                <Path Width="18" Height="16" Data="M 1,1 L 1,15 L 18,15 M 3,11 L 7,6 L 11,9 L 17,2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource LocDailyTokensDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,-4,0,10" />
                    <Grid Visibility="{Binding HasHistoryOfficialDays, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl x:Name="HistoryDailyList" ItemsSource="{Binding DailyUsage}" Visibility="{Binding IsHistoryListVisible, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="37">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="158" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Date}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" />
                                    <ProgressBar Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="{Binding RelativeWidth, Mode=OneWay}" Maximum="100" Margin="6,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Tokens}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Visibility="{Binding IsHistoryTrendVisible, Converter={StaticResource BoolToVisibility}}">
                        <controls:HistoryTrendChart x:Name="HistoryDailyTrend" Height="238" Data="{Binding HistoryTrend}" IsEnglish="{Binding IsEnglish}"
                                                   FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Background="Transparent"
                                                   LineBrush="{DynamicResource BlueBrush}" GridBrush="{DynamicResource CardBorderBrush}" PointFocusBrush="{DynamicResource AccentFocusBrush}"
                                                   TipSurface="{DynamicResource FlyoutSurfaceBrush}" TipForeground="{DynamicResource InkBrush}" TipBorder="{DynamicResource FlyoutBorderBrush}"
                                                   FocusVisualStyle="{StaticResource KeyboardFocusVisual}" AutomationProperties.Name="{DynamicResource LocHistoryTrend}"
                                                   AutomationProperties.HelpText="{DynamicResource LocHistoryTrendHelp}" />
                        <TextBlock Text="{DynamicResource LocHistoryTrendHelp}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource LocHistoryNoOfficialDays}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" Visibility="{Binding HasHistoryOfficialDays, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Border Background="{DynamicResource InsetBrush}" CornerRadius="10" Padding="13" Margin="0,6,0,0">
                        <TextBlock Text="{DynamicResource LocHistoryPortable}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource CardButton}" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,14">
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xF42F;" FontFamily="{StaticResource FluentIconFont}" FontSize="19" Foreground="{DynamicResource IndigoBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource LocOpenLocalDataFolder}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource LocDataFolderDescription}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="&#xF182;" FontFamily="{StaticResource FluentIconFont}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
