<UserControl x:Class="CodexUsageMonitor.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CodexUsageMonitor.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,4,22,22">
            <Border Background="{DynamicResource WarningPanelBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,0,0,12"
                    Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarningTextBrush}" FontSize="11" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="188" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid x:Name="WeeklyQuotaCircle" Width="166" Height="166" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:CircularProgress Value="{Binding WeeklyRemaining}" Fill="{DynamicResource IndigoBrush}" Track="{DynamicResource IndigoTrackBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource LocWeeklyRemaining}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WeeklyRemainingText}" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource IndigoBrush}" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                            <TextBlock x:Name="WeeklyResetText"
                                       Text="{Binding WeeklyResetText}"
                                       Width="148"
                                       FontSize="11"
                                       LineHeight="14"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Column="1" Background="{DynamicResource LineBrush}" Margin="0,8" />
                    <StackPanel Grid.Column="2" Margin="22,2,0,0">
                        <Grid Margin="0,0,0,12" Visibility="{Binding GeneralFiveHourVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LocGeneralFiveHour}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding GeneralFiveReset}" Foreground="{DynamicResource MutedBrush}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="{Binding GeneralFiveRemainingPercent, Mode=OneWay}" Maximum="100" Margin="10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding GeneralFiveRemaining}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource BlueBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Grid>
                        <TextBlock Text="{DynamicResource LocQuotaPace}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        <TextBlock Text="{Binding PaceText}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource IndigoBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PaceWillExhaust}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding PaceDetailText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,12" TextWrapping="Wrap" />
                        <UniformGrid Columns="7" Margin="0,0,0,2">
                            <TextBlock Text="{DynamicResource LocDay1}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LocDay2}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LocDay3}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LocDay4}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LocDay5}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LocDay6}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{DynamicResource LocDay7}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                        </UniformGrid>
                        <controls:WeeklyPaceBar Height="34" UsedPercent="{Binding PaceUsedPercent}" ElapsedPercent="{Binding PaceElapsedPercent}" WillExhaust="{Binding PaceWillExhaust}"
                                                Track="{DynamicResource ProgressTrackBrush}" Remaining="{DynamicResource BlueBrush}" Warning="{DynamicResource AmberBrush}"
                                                Consumed="{DynamicResource PaceConsumedBrush}" Divider="{DynamicResource PaceDividerBrush}" Marker="{DynamicResource PaceMarkerBrush}" />
                        <TextBlock Text="{Binding PaceWindowText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14"
                    Visibility="{Binding SparkVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <TextBlock Text="{DynamicResource LocSparkLimit}" FontWeight="SemiBold" FontSize="15" />
                        <Border HorizontalAlignment="Right" Background="{DynamicResource IndigoSubtleBrush}" CornerRadius="8" Padding="8,3">
                            <TextBlock Text="PRO+" Foreground="{DynamicResource IndigoBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,5" Visibility="{Binding SparkFiveHourVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource LocFiveHourWindow}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar x:Name="SparkFiveProgress" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="{Binding SparkFiveRemainingPercent, Mode=OneWay}" Maximum="100" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SparkFiveRemaining}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SparkFiveResetText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding SparkFiveReset}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SparkFiveReset}" />
                    </Grid>
                    <Grid Margin="0,7,0,0" Visibility="{Binding SparkWeeklyVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource LocWeeklyWindow}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar x:Name="SparkWeeklyProgress" Grid.Column="1" Style="{StaticResource FlatProgressBar}" Value="{Binding SparkWeeklyRemainingPercent, Mode=OneWay}" Maximum="100" Margin="12,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding SparkWeeklyRemaining}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource BlueBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="SparkWeeklyResetText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding SparkWeeklyReset}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SparkWeeklyReset}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource CardButton}" Command="{Binding ShowResetDetailsCommand}" Margin="0,0,0,14">
                <Grid Margin="17,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="{DynamicResource AmberSubtleBrush}" CornerRadius="12">
                        <TextBlock Text="&#xED7D;" FontFamily="{StaticResource FluentIconFont}" FontSize="20" Foreground="{DynamicResource AmberBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource LocResetCards}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResetSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResetCreditCountText}" Foreground="{DynamicResource AmberBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="&#xF182;" FontFamily="{StaticResource FluentIconFont}" Foreground="{DynamicResource MutedBrush}" Margin="8,1,0,0" />
                    </StackPanel>
                </Grid>
            </Button>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LocMonthlyTokens}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="{Binding OfficialMonthTokens}" FontSize="31" FontWeight="SemiBold" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding OfficialMonthStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
